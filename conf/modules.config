/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Config file for defining DSL2 per module options and publishing paths
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Available keys to override module options:
        ext.args   = Additional arguments appended to command in module.
        ext.args2  = Second set of arguments appended to command in module (multi-tool modules).
        ext.args3  = Third set of arguments appended to command in module (multi-tool modules).
        ext.prefix = File name prefix for output files.
----------------------------------------------------------------------------------------
*/

process {

    publishDir = [
        path: { "${params.outdir}/${task.process.tokenize(':')[-1].tokenize('_')[0].toLowerCase()}" },
        mode: params.publish_dir_mode,
        saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
    ]

    withName: FASTQC {
        ext.args = '--quiet'
        publishDir = [
            path: {
                if (meta.long_reads) {
                    "${params.outdir}/${meta.id}/long_reads/qc_metrics"
                } else {
                    "${params.outdir}/${meta.id}/short_reads/qc_metrics"
                }
            },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'MULTIQC' {
        ext.args   = { params.multiqc_title ? "--title \"$params.multiqc_title\"" : '' }
        publishDir = [
            path: { "${params.outdir}/multiqc" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'BUILD_MULTIQC_SECTIONS' {
        publishDir = [
            [
                path: { "${params.outdir}" },
                mode: params.publish_dir_mode,
                enabled: params.virus_preset == "hcv" && params.run_hcv_glue,
                pattern: "coverage_per_genomic_region.pdf",
                overwrite: true,
                saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
            ],
            [
                path: { "${params.outdir}/multiqc/build" },
                mode: params.publish_dir_mode,
                enabled: true,
                pattern: "*_mqc.json",
                overwrite: true,
                saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
            ]
        ]
    }

    withName: 'NANOQ' {
        ext.args = [
            "--header",
            "--min-len ${params.long_reads_min_len}",
            "--max-len ${params.long_reads_max_len}",
            "--min-qual ${params.long_reads_min_qual}",
        ].join(' ').trim()
        publishDir = [
            [
                path: { "${params.outdir}/${meta.id}/long_reads/clean_reads" },
                mode: params.publish_dir_mode,
                pattern: "*.{stats}",
                enabled: true,
                saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
            ],
            [
                path: { "${params.outdir}/${meta.id}/long_reads/clean_reads" },
                mode: params.publish_dir_mode,
                pattern: "*.{fastq,fq,fastq.gz,fq.gz}",
                enabled: params.save_trimmed_long_reads,
                saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
            ]
        ]
    }

    withName: FASTP {
        ext.args = [
            "-q ${params.fastp_qualified_quality}",
            "-u ${params.fastp_unqualified_percent_limit}",
            "--cut_front",
            "--cut_tail",
            "--cut_mean_quality ${params.fastp_cut_mean_quality}",
            "--length_required ${params.short_reads_min_len}",
            params.fastp_low_complexity_filter ? "--low_complexity_filter --complexity_threshold ${params.fastp_complexity_threshold}" : "",
            params.fastp_error_correction ? "--correction" : "",
            params.fastp_interleaved_in ? "--interleaved_in" : "",
        ].join(' ').trim()
        publishDir = [
            [
                path: { "${params.outdir}/${meta.id}/short_reads/clean_reads" },
                mode: params.publish_dir_mode,
                pattern: "*.{html,json}"
            ],
            [
                path: { "${params.outdir}/${meta.id}/short_reads/clean_reads" },
                mode: params.publish_dir_mode,
                pattern: "*.fastq.gz",
                enabled: params.save_trimmed_short_reads
            ]
        ]
        tag = { "${meta.id}" }
    }

    withName: 'SELECT_BEST_REFERENCE' {
        ext.args = [
            params.abundance_top_percentage ? "--top ${params.abundance_top_percentage}" : '--top 5',
            params.reference_selection_tool == "salmon" ? "--salmon" : '',
        ].join(' ').trim()
        publishDir = [
            path: {
                if (meta.long_reads) {
                    "${params.outdir}/${meta.id}/long_reads/reference_selection"
                } else {
                    "${params.outdir}/${meta.id}/short_reads/reference_selection"
                }
            },
            mode: params.publish_dir_mode,
            pattern: "*.{tsv}",
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'MINIMAP2_REFERENCE_INDEX' {
        publishDir = [
            path: { "${params.outdir}/reference_selection_index" },
            mode: params.publish_dir_mode,
            enabled: false,
            pattern: "*.mmi",
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'MINIMAP2_COMPETITIVE_MAP' {
        ext.args = {
            def args = []
            args << "-x ${meta.long_reads ? params.minimap2_reference_selection_long_preset : params.minimap2_reference_selection_short_preset}"
            if (params.extra_minimap2_reference_selection_args) {
                args << params.extra_minimap2_reference_selection_args
            }
            args.join(' ')
        }
        publishDir = [
            path: {
                if (meta.long_reads) {
                    "${params.outdir}/${meta.id}/long_reads/reference_selection"
                } else {
                    "${params.outdir}/${meta.id}/short_reads/reference_selection"
                }
            },
            mode: params.publish_dir_mode,
            pattern: "*.competitive.bam*",
            enabled: true,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'SELECT_REFERENCE_FROM_BAM' {
        ext.args = {
            !meta.long_reads && params.minimap2_reference_selection_short_breadth_tiebreaker ? "--use-coverage-breadth" : ""
        }
        publishDir = [
            path: {
                if (meta.long_reads) {
                    "${params.outdir}/${meta.id}/long_reads/reference_selection"
                } else {
                    "${params.outdir}/${meta.id}/short_reads/reference_selection"
                }
            },
            mode: params.publish_dir_mode,
            pattern: "*.{tsv,txt}",
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'REFERENCE_METADATA_FROM_FASTA' {
        publishDir = [
            path: {
                if (meta.long_reads) {
                    "${params.outdir}/${meta.id}/long_reads/reference_selection"
                } else {
                    "${params.outdir}/${meta.id}/short_reads/reference_selection"
                }
            },
            mode: params.publish_dir_mode,
            pattern: "*.{tsv,txt}",
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'SEQKIT_GREP' {
        ext.args   = { '' }
        publishDir = [
            path: {
                if (meta2.long_reads) {
                    "${params.outdir}/${meta2.id}/long_reads/reference_selection"
                } else {
                    "${params.outdir}/${meta2.id}/short_reads/reference_selection"
                }
            },
            mode: params.publish_dir_mode,
            pattern: "*.{fasta,fa}",
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'CALCULATE_READ_STATS' {
        ext.args   = { '' }
        publishDir = [
            path: {
                if (meta.long_reads) {
                    "${params.outdir}/${meta.id}/long_reads/qc_metrics"
                } else {
                    "${params.outdir}/${meta.id}/short_reads/qc_metrics"
                }
            },
            mode: params.publish_dir_mode,
            enabled: true,
            pattern: "*.{txt}",
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'SEQKIT_STATS' {
        ext.args = { '--all' }
        publishDir = [
            path: {
                if (meta.long_reads) {
                    "${params.outdir}/${meta.id}/long_reads/qc_metrics"
                } else {
                    "${params.outdir}/${meta.id}/short_reads/qc_metrics"
                }
            },
            mode: params.publish_dir_mode,
            enabled: true,
            pattern: "*.tsv",
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'SEQKIT_STATS_RAW_LONG' {
        ext.prefix = { "${meta.id}.raw_long" }
    }

    withName: 'SEQKIT_STATS_CLEAN_LONG' {
        ext.prefix = { "${meta.id}.clean_long" }
    }

    withName: 'SEQKIT_STATS_RAW_SHORT' {
        ext.prefix = { "${meta.id}.raw_short" }
    }

    withName: 'SEQKIT_STATS_CLEAN_SHORT' {
        ext.prefix = { "${meta.id}.clean_short" }
    }

    withName: 'KALLISTO_INDEX' {
        ext.args   = { '' }
        publishDir = [
            path: {
                if (meta.long_reads) {
                    "${params.outdir}/${meta.id}/long_reads/reference_selection"
                } else {
                    "${params.outdir}/${meta.id}/short_reads/reference_selection"
                }
            },
            mode: params.publish_dir_mode,
            enabled: false,
            pattern: "*",
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'KALLISTO_QUANT' {
        ext.args   = { '' }
        publishDir = [
            path: {
                if (meta.long_reads) {
                    "${params.outdir}/${meta.id}/long_reads/reference_selection"
                } else {
                    "${params.outdir}/${meta.id}/short_reads/reference_selection"
                }
            },
            mode: params.publish_dir_mode,
            enabled: true,
            pattern: "*.{tsv,log,json}",
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'SALMON_INDEX' {
        ext.args   = { '' }
        publishDir = [
            path: {
                if (meta.long_reads) {
                    "${params.outdir}/${meta.id}/long_reads/reference_selection"
                } else {
                    "${params.outdir}/${meta.id}/short_reads/reference_selection"
                }
            },
            mode: params.publish_dir_mode,
            enabled: false,
            pattern: "*",
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'SALMON_QUANT' {
        ext.args = {
            def args = []
            if (meta.long_reads) {
                args << "--ont"
            }
            if (params.extra_salmon_args) {
                args << params.extra_salmon_args
            }
            args << "--minAssignedFrags 1"
            args.join(' ')
        }
        publishDir = [
            path: {
                if (meta.long_reads) {
                    "${params.outdir}/${meta.id}/long_reads/reference_selection"
                } else {
                    "${params.outdir}/${meta.id}/short_reads/reference_selection"
                }
            },
            mode: params.publish_dir_mode,
            enabled: true,
            pattern: "*.{tsv,log,json}",
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'BWA_INDEX' {
        ext.args   = { '' }
        publishDir = [
            path: {
                if (meta.long_reads) {
                    "${params.outdir}/${meta.id}/long_reads/primer_clipping"
                } else {
                    "${params.outdir}/${meta.id}/short_reads/primer_clipping"
                }
            },
            mode: params.publish_dir_mode,
            pattern: "*.{bam}",
            enabled: false,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'BWA_MEM' {
        ext.args   = { '-k 5 -T 16' }
        ext.args2   = { '--write-index' }
        publishDir = [
            path: {
                if (meta.long_reads) {
                    "${params.outdir}/${meta.id}/long_reads/primer_clipping"
                } else {
                    "${params.outdir}/${meta.id}/short_reads/primer_clipping"
                }
            },
            mode: params.publish_dir_mode,
            pattern: "*.{bam}",
            enabled: false,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'BEDTOOLS_BAMTOBED' {
        publishDir = [
            path: {
                if (meta.long_reads) {
                    "${params.outdir}/${meta.id}/long_reads/primer_clipping"
                } else {
                    "${params.outdir}/${meta.id}/short_reads/primer_clipping"
                }
            },
            mode: params.publish_dir_mode,
            pattern: "*.{bed}",
            enabled: true,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'SPLIT_CONSENSUS_GENOMES' {
        ext.args = [
            "",
        ].join(' ').trim()
        ext.prefix = { meta.consensus_type == 'simple' ? "${meta.id}.simple" : "${meta.id}" }
        publishDir = [
            [
                path: {
                    if (meta.long_reads) {
                        "${params.outdir}/${meta.id}/long_reads/consensus"
                    } else {
                        "${params.outdir}/${meta.id}/short_reads/consensus"
                    }
                },
                mode: params.publish_dir_mode,
                pattern: "*.{fa}",
                enabled: true,
                saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
            ],
            [
                path: { "${params.outdir}/all_consensus_genomes" },
                mode: params.publish_dir_mode,
                pattern: "*.{fa}",
                enabled: true,
                saveAs: { filename ->
                    filename.equals('versions.yml') ? null : "${meta.id}.${meta.long_reads ? 'long_reads' : 'short_reads'}.${filename}"
                }
            ],
        ]
    }


    withName: 'SAMTOOLS_AMPLICONCLIP' {
        ext.args = [
            params.clip_both_ends ? '--both-ends' : '',
            params.clip_tolerance ? "--tolerance ${params.clip_tolerance}" : "--tolerance 5",
            params.hard_clip_alignment ? '--hard-clip' : '',
            params.clip_ignore_strand ? '' : '--strand',
        ].join(' ').trim()
        publishDir = [
            path: {
                if (meta.long_reads) {
                    "${params.outdir}/${meta.id}/long_reads/primer_clipping"
                } else {
                    "${params.outdir}/${meta.id}/short_reads/primer_clipping"
                }
            },
                mode: params.publish_dir_mode,
                pattern: "*.{bed}",
                enabled: true,
                saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'MINIMAP2_ALIGN' {
        ext.args   = { meta.long_reads ? "-x map-ont" : "-x sr"  }
        publishDir = [
            path: {
                if (meta.long_reads) {
                    "${params.outdir}/${meta.id}/long_reads/read_mapping"
                } else {
                    "${params.outdir}/${meta.id}/short_reads/read_mapping"
                }
            },
            mode: params.publish_dir_mode,
            pattern: "*.{bam,bai}",
            enabled: false,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'SAMTOOLS_SORT' {
        ext.args   = { '--write-index' }
        publishDir = [
            path: {
                if (meta.long_reads) {
                    "${params.outdir}/${meta.id}/long_reads/consensus"
                } else {
                    "${params.outdir}/${meta.id}/short_reads/consensus"
                }
            },
            mode: params.publish_dir_mode,
            pattern: "*.{bam,csi}",
            enabled: false ,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
        ext.prefix = { "${meta.id}.sorted" }
    }

    withName: 'CLAIR3' {
        ext.args = [
            "--model_path=${params.clair3_model_path}",
            "--platform=${params.clair3_platform}",
            "--chunk_size=${params.clair3_chunk_size}",
            "--include_all_ctgs",
            "--no_phasing_for_fa",
            "--remove_intermediate_dir",
            "--enable_long_indel",
            "--haploid_sensitive",
            "--keep_iupac_bases",
        ].join(' ').trim()
        publishDir = [
            path: { "${params.outdir}/${meta.id}/long_reads/variant_calling" },
            mode: params.publish_dir_mode,
            pattern: "*.{vcf,vcf.gz}",
            enabled: true ,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'LOFREQ_INDELQUAL' {
        publishDir = [
            path: {
                if (meta.long_reads) {
                    "${params.outdir}/${meta.id}/long_reads/variant_calling"
                } else {
                    "${params.outdir}/${meta.id}/short_reads/variant_calling"
                }
            },
            mode: params.publish_dir_mode,
            enabled: false,
            pattern: "*.bam*",
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'LOFREQ_CALL' {
        publishDir = [
            path: {
                if (meta.long_reads) {
                    "${params.outdir}/${meta.id}/long_reads/variant_calling"
                } else {
                    "${params.outdir}/${meta.id}/short_reads/variant_calling"
                }
            },
            mode: params.publish_dir_mode,
            enabled: false,
            pattern: "*.vcf.gz*",
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'PREPARE_CLAIR3_VCF' {
        publishDir = [
            path: {
                if (meta.long_reads) {
                    "${params.outdir}/${meta.id}/long_reads/variant_calling"
                } else {
                    "${params.outdir}/${meta.id}/short_reads/variant_calling"
                }
            },
            mode: params.publish_dir_mode,
            enabled: false,
            pattern: "*.vcf.gz*",
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'PREPARE_LOFREQ_VCF' {
        publishDir = [
            path: {
                if (meta.long_reads) {
                    "${params.outdir}/${meta.id}/long_reads/variant_calling"
                } else {
                    "${params.outdir}/${meta.id}/short_reads/variant_calling"
                }
            },
            mode: params.publish_dir_mode,
            enabled: false,
            pattern: "*.vcf.gz*",
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'FILTER_VARIANTS' {
        publishDir = [
            path: {
                if (meta.long_reads) {
                    "${params.outdir}/${meta.id}/long_reads/variant_calling"
                } else {
                    "${params.outdir}/${meta.id}/short_reads/variant_calling"
                }
            },
            mode: params.publish_dir_mode,
            pattern: "*.final*.vcf.gz*",
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'ANNOTATE_VARIANTS' {
        publishDir = [
            path: {
                if (meta.long_reads) {
                    "${params.outdir}/${meta.id}/long_reads/variant_calling"
                } else {
                    "${params.outdir}/${meta.id}/short_reads/variant_calling"
                }
            },
            mode: params.publish_dir_mode,
            pattern: "*.annotated.tsv",
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'CREATE_CONSENSUS_MASK' {
        publishDir = [
            path: {
                if (meta.long_reads) {
                    "${params.outdir}/${meta.id}/long_reads/consensus"
                } else {
                    "${params.outdir}/${meta.id}/short_reads/consensus"
                }
            },
            mode: params.publish_dir_mode,
            enabled: false,
            pattern: "*.mask.bed",
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'BCFTOOLS_CONSENSUS' {
        publishDir = [
            path: {
                if (meta.long_reads) {
                    "${params.outdir}/${meta.id}/long_reads/consensus"
                } else {
                    "${params.outdir}/${meta.id}/short_reads/consensus"
                }
            },
            mode: params.publish_dir_mode,
            enabled: false,
            pattern: "*.fa",
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }


    withName: 'REMOVE_EMPTY_SEQUENCES' {
        ext.args   = { '' }
        publishDir = [
            [
                path: {
                    if (meta.long_reads) {
                        "${params.outdir}/${meta.id}/long_reads/reporting"
                    } else {
                        "${params.outdir}/${meta.id}/short_reads/reporting"
                    }
                },
                mode: params.publish_dir_mode,
                pattern: "*.empty.fasta",
                enabled: params.run_hcv_glue,
                saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
            ]
        ]
    }

    withName: 'HCV_GLUE' {
        ext.args   = { '' }
        publishDir = [
            [
                path: {
                    if (meta.long_reads) {
                        "${params.outdir}/${meta.id}/long_reads/reporting"
                    } else {
                        "${params.outdir}/${meta.id}/short_reads/reporting"
                    }
                },
                mode: params.publish_dir_mode,
                overwrite: true,
                pattern: "*.{html}",
                saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
            ],
            [
                path: { "${params.outdir}/all_reports" },
                mode: params.publish_dir_mode,
                overwrite: true,
                pattern: "*.{html}",
                saveAs: { filename ->
                    filename.equals('versions.yml') ? null : "${meta.id}.${meta.long_reads ? 'long_reads' : 'short_reads'}.hcv_glue.html"
                }
            ]
        ]
    }

    withName: 'GENERATE_WHOLE_GENOME_BED' {
        publishDir = [
            path: {
                if (meta.long_reads) {
                    "${params.outdir}/${meta.id}/long_reads/coverage"
                } else {
                    "${params.outdir}/${meta.id}/short_reads/coverage"
                }
            },
            mode: params.publish_dir_mode,
            enabled: false,
            pattern: "*.bed",
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'MOSDEPTH_GENOME' {
        ext.args = { "--fast-mode --thresholds ${params.consensus_min_depth}" }
        publishDir = [
            path: {
                if (meta.long_reads) {
                    "${params.outdir}/${meta.id}/long_reads/coverage"
                } else {
                    "${params.outdir}/${meta.id}/short_reads/coverage"
                }
            },
            mode: params.publish_dir_mode,
            enabled: true,
            pattern: "*.{txt,bed.gz,csi}",
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'COVERAGE_METRICS' {
        publishDir = [
            path: {
                if (meta.long_reads) {
                    "${params.outdir}/${meta.id}/long_reads/coverage"
                } else {
                    "${params.outdir}/${meta.id}/short_reads/coverage"
                }
            },
            mode: params.publish_dir_mode,
            pattern: "*.tsv",
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'PARSE_HCV_GLUE_COVERAGE' {
        publishDir = [
            path: {
                if (meta.long_reads) {
                    "${params.outdir}/${meta.id}/long_reads/reporting"
                } else {
                    "${params.outdir}/${meta.id}/short_reads/reporting"
                }
            },
            mode: params.publish_dir_mode,
            overwrite: true,
            pattern: "*.tsv",
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'PLOT_HCV_SUMMARY' {
        publishDir = [
            path: {
                if (meta.long_reads) {
                    "${params.outdir}/${meta.id}/long_reads/reporting"
                } else {
                    "${params.outdir}/${meta.id}/short_reads/reporting"
                }
            },
            mode: params.publish_dir_mode,
            overwrite: true,
            pattern: "*.png",
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'PLOT_DEPTH_SUMMARY' {
        publishDir = [
            path: {
                if (meta.long_reads) {
                    "${params.outdir}/${meta.id}/long_reads/reporting"
                } else {
                    "${params.outdir}/${meta.id}/short_reads/reporting"
                }
            },
            mode: params.publish_dir_mode,
            overwrite: true,
            pattern: "*.png",
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: /RENDER_(HCV_)?SUMMARY_REPORT|RENDER_HCV_REPORT/ {
        publishDir = [
            [
                path: {
                    if (meta.long_reads) {
                        "${params.outdir}/${meta.id}/long_reads/reporting"
                    } else {
                        "${params.outdir}/${meta.id}/short_reads/reporting"
                    }
                },
                mode: params.publish_dir_mode,
                overwrite: true,
                pattern: "*.pdf",
                saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
            ],
            [
                path: { "${params.outdir}/all_reports" },
                mode: params.publish_dir_mode,
                overwrite: true,
                pattern: "*.pdf",
                saveAs: { filename ->
                    filename.equals('versions.yml') ? null : "${meta.id}.${meta.long_reads ? 'long_reads' : 'short_reads'}.summary_report.pdf"
                }
            ]
        ]
    }

    withName: 'SAMTOOLS_FAIDX' {
        publishDir = [
            path: { "${params.outdir}/samtools" },
            mode: params.publish_dir_mode,
            enabled: false,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'COUNT_MAPPED_READS' {
        publishDir = [
            path: {
                if (meta.long_reads) {
                    "${params.outdir}/${meta.id}/long_reads/coverage"
                } else {
                    "${params.outdir}/${meta.id}/short_reads/coverage"
                }
            },
            mode: params.publish_dir_mode,
            pattern: "*.txt",
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'BUILD_RUN_SUMMARY' {
        publishDir = [
            [
                path: { "${params.outdir}" },
                mode: params.publish_dir_mode,
                pattern: "combined_results_summary.csv",
                overwrite: true
            ],
            [
                path: { "${params.outdir}/multiqc/build" },
                mode: params.publish_dir_mode,
                pattern: "combined_results_summary_mqc.json",
                overwrite: true
            ]
        ]
    }
}
