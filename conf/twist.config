/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config file for Twist hybrid-capture (Illumina) data
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Sensible settings for PCR-amplified, probe-captured libraries:
      - no amplicon primers, so primer trimming is skipped
      - duplicates are flagged before variant calling and depth calculation

    Combine with a container profile and the usual inputs; anything set here can be
    overridden with --params-file.

    Use as follows:
        nextflow run charlesfoster/h2seq -profile twist,<docker/singularity> -params-file params.yml

----------------------------------------------------------------------------------------
*/

params {
    config_profile_name        = 'Twist profile'
    config_profile_description = 'Settings for Twist hybrid-capture Illumina data: skip primer trimming and mark duplicates'

    skip_primer_trimming = true
    mark_duplicates      = true
}
